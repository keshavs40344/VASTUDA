# VASTUDA Search Engine — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# --- REQUIRED IN PRODUCTION ---
# A cryptographically random secret key for Flask session signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If missing in production, the server will REFUSE to start.
SECRET_KEY=

# --- OPTIONAL: External AI providers ---
# Groq API key for AI overviews (LLM synthesis). Free tier available at console.groq.com
GROQ_API_KEY=

# Tavily API key for external web retrieval. Free tier at app.tavily.com
TAVILY_API_KEY=

# --- SERVER CONFIGURATION ---
# Port to bind to. Render sets this automatically.
PORT=5000

# Flask environment. Use "development" locally to get ephemeral SECRET_KEY instead of startup fail.
# NEVER set to "development" in production.
FLASK_ENV=production

# --- CORS ---
# Comma-separated list of allowed origins for CORS.
# Defaults include localhost:5000, localhost:3000, vastuda-search.onrender.com, and app:// (Electron).
# Only override if you add a custom domain.
# ALLOWED_ORIGINS=https://vastuda-search.onrender.com,http://localhost:5000,app://.

# --- SEARCH CACHE ---
# TTL in seconds for in-memory search result cache (default: 900 = 15 min)
# SEARCH_CACHE_TTL_SECONDS=900

# --- DEBUG (dev only) ---
# Set a key to enable debug ranking info in /api/search responses
# DEBUG_RANKING_KEY=

# --- TELEGRAM NOTIFICATIONS (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
